{
  "name": "@keload/node-red-contrib-ultimate-toolkit",
  "version": "1.17.0",
  "description": "A collection of (moderns) useful tools for Node-RED",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm typecheck",
    "build": "node-red-dxp build",
    "postbuild": "pnpm generate:readme",
    "dev": "node-red-dxp watch",
    "format": "biome format",
    "lint": "biome lint",
    "lint:check": "biome check",
    "lint:ci": "biome ci",
    "release": "pnpm release-it",
    "release:test": "pnpm release-it --dry-run",
    "generate:readme": "pnpm tsx build-readme.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "all": "dist/index.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@formkit/tempo": "^1.1.1",
    "@keload/node-red-dxp": "2.1.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/jquery": "4.0.1",
    "@types/jqueryui": "1.12.25",
    "@types/node": "^26.6.6",
    "@types/node-red": "1.3.5",
    "@vitest/coverage-v8": "^5.1.0",
    "es-toolkit": "1.53.2",
    "radash": "12.1.1",
    "release-it": "21.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "node-red",
    "node-red-contrib",
    "node-red-dxp",
    "toolkit",
    "utilities"
  ],
  "author": "Clément BERARD <contact@berard.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clement-berard/node-red-contrib-ultimate-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/clement-berard/node-red-contrib-ultimate-toolkit/issues"
  },
  "homepage": "https://github.com/clement-berard/node-red-contrib-ultimate-toolkit",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
