{
  "name": "@keload/node-red-contrib-ultimate-toolkit",
  "version": "1.15.0",
  "description": "A collection of (moderns) useful tools for Node-RED",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm typecheck",
    "build": "node-red-dxp build",
    "dev": "node-red-dxp watch",
    "format": "biome format",
    "lint": "pnpm biome lint",
    "lint:check": "biome check",
    "release": "pnpm release-it",
    "release:test": "pnpm release-it --dry-run",
    "generate:readme": "pnpm tsx build-readme.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "all": "dist/index.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@formkit/tempo": "^1.1.0",
    "@keload/node-red-dxp": "2.0.0-beta.2",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/jquery": "4.0.1",
    "@types/jqueryui": "1.12.24",
    "@types/node": "^26.1.1",
    "@types/node-red": "1.3.5",
    "es-toolkit": "1.50.0",
    "radash": "12.1.1",
    "release-it": "20.2.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "node-red",
    "node-red-contrib",
    "node-red-dxp",
    "toolkit",
    "utilities"
  ],
  "author": "Clément BERARD <contact@berard.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clement-berard/node-red-contrib-ultimate-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/clement-berard/node-red-contrib-ultimate-toolkit/issues"
  },
  "homepage": "https://github.com/clement-berard/node-red-contrib-ultimate-toolkit",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
